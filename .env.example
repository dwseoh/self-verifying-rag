# Cerebras Inference — https://inference-docs.cerebras.ai/
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gemma-4-31b

# Set to 1 to use fixture agent outputs (no API calls)
TRUSTLOOP_MOCK=1

# Set to 1 to make /api/verify return static fixtures only (frontend dev)
TRUSTLOOP_FIXTURE_API=0

# Paths (defaults work for local dev)
TRUSTLOOP_REPO_PATH=data/demo_repo
TRUSTLOOP_CORPUS_PATH=data/engineering_corpus
TRUSTLOOP_STORE_PATH=data/store
TRUSTLOOP_CLONES_PATH=data/clones
TRUSTLOOP_ALLOW_ABSOLUTE_PATHS=1
TRUSTLOOP_PUBLIC_API_URL=
TRUSTLOOP_GIT_REPO=https://github.com/dwseoh/self-verifying-rag.git
GITHUB_CLONE_TOKEN=
TRUSTLOOP_DISCOVERY_ROOTS=

# =============================================================================
# SaaS / Neon (Next.js frontend only)
# Copy these to frontend/.env.local — the Python backend does NOT read them.
# Full list + comments: frontend/.env.example
# =============================================================================
#
# Neon — create project at https://neon.tech, then run:
#   psql "$DATABASE_URL" -f frontend/drizzle/migrations/0000_init.sql
#   # or: cd frontend && npm run db:push
#
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# AUTH_SECRET=                    # openssl rand -base64 32
# NEXTAUTH_URL=http://localhost:5173
#
# GITHUB_ID=                        # OAuth App Client ID
# GITHUB_SECRET=                    # OAuth App Client secret
# GITHUB_WEBHOOK_SECRET=            # openssl rand -hex 32 (PR webhook HMAC)
#
# TRUSTLOOP_WEBHOOK_URL=https://your-app.vercel.app/api/webhooks/github
# TRUSTLOOP_BACKEND_URL=http://localhost:8000
# TRUSTLOOP_PUBLIC_API_URL=http://localhost:8000
