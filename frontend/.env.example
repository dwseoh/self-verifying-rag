# =============================================================================
# REQUIRED for SaaS (auth, repos, runs in Neon)
# Copy this file to frontend/.env.local
# =============================================================================

# Neon Postgres — https://neon.tech
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Auth.js — openssl rand -base64 32
AUTH_SECRET=

# App URL (local dev)
NEXTAUTH_URL=http://localhost:5173

# Python verify API (proxied as /backend in dev via next.config.ts)
TRUSTLOOP_BACKEND_URL=http://localhost:8000

# =============================================================================
# OPTIONAL — only if you use these features
# =============================================================================

# GitHub OAuth — ONLY for "Sign in with GitHub" + "Add GitHub repo" in dashboard
# Email/password signup works without these.
# GITHUB_ID=
# GITHUB_SECRET=
# Allow linking GitHub to an existing email account (production)
# AUTH_ALLOW_EMAIL_LINKING=1

# PR webhook CI — ONLY if you connect GitHub repos and want auto PR checks
# GITHUB_WEBHOOK_SECRET=
# TRUSTLOOP_WEBHOOK_URL=https://your-app.vercel.app/api/webhooks/github

# Public backend URL for MCP install script (defaults to TRUSTLOOP_BACKEND_URL)
# TRUSTLOOP_PUBLIC_API_URL=

# Git clone source for MCP install script (required for curl install)
# TRUSTLOOP_GIT_REPO=https://github.com/YOUR_ORG/trustloop.git

# Clone private repos on the Python backend
# GITHUB_CLONE_TOKEN=
